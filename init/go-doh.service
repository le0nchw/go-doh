[Unit]
Description=Go DOH Proxy
After=network.target

[Service]
Restart=always
# ponytail: run as an unprivileged user, not root, to limit blast radius if
# the proxy is compromised (F10). Create the user/group before installing.
User=doh
Group=doh
ExecStart=/usr/local/bin/doh

[Install]
WantedBy=multi-user.target
